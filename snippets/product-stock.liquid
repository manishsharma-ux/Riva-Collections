<script>
  function generateRandomNumber() {
    let progressBar = document.getElementById("progress-fill");
    let randomNumberElement = document.getElementById("random-number");

    // Generate a random number (1-10)
    let randomNum = Math.floor(Math.random() * 9) + 2;

    // Convert number to percentage (1 = 10%, 10 = 100%)
    let progressWidth = randomNum * 10 + "%";

    // Reset and animate progress bar
    progressBar.style.width = "0%";
    setTimeout(() => {
      progressBar.style.width = progressWidth;
    }, 100);

    // Show number after progress completes
    setTimeout(() => {
      randomNumberElement.textContent =  randomNum;
    }, 0);
  }

  // Generate number on page load
  document.addEventListener("DOMContentLoaded", generateRandomNumber);
</script>
