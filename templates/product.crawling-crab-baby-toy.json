    "collapsible_content_EUY8hK": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What Age Is It Really For?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>[FILL: publish the supplier's tested age grading and any small-parts warning — do not simply repeat \"0–3 years\".] A toy that moves and makes noise suits a baby who is already doing tummy time and reaching, not a newborn. And at the top of that range, a toddler who can pull at seams needs different supervision from a six-month-old.</p>",
            "page": ""
          }
        },
        "collapsible_row_q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is The Battery Compartment Secure?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>[FILL: this is the most important answer on the page. The listing describes reaching the battery by unzipping the plush. Confirm whether it is screw-secured underneath that zip.] A battery a small child can reach is a serious hazard — swallowed cells cause severe internal injuries very quickly. If the compartment is only a zip, it needs securing before this goes on sale, not a warning line.</p>",
            "page": ""
          }
        },
        "collapsible_row_q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How Loud Is It?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>[FILL: state the sound level in dB and whether the volume is adjustable.] Babies hold toys right against their ears, and at that distance a loud toy is a genuine hearing concern. If there is no volume control, say so plainly rather than letting parents find out.</p>",
            "page": ""
          }
        },
        "collapsible_row_q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will It Move On Our Floor?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>[FILL: state which surfaces it works on.] Bouncing plush toys travel well on tile and wood and tend to stall on carpet and rugs. Most Indian living rooms have a rug somewhere, so being honest about this prevents the most predictable complaint on the product.</p>",
            "page": ""
          }
        },
        "collapsible_row_q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Should My Baby Play With It Alone?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>No. Stay with them. It is an electronic toy with a motor and a battery inside a soft body, and babies at this age explore with their mouths. Check the seams and the plush every few days, and stop using it if anything has come loose or the fabric has split.</p>",
            "page": ""
          }
        },
        "collapsible_row_q6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How Do I Clean It?",
            "icon": "quiz",
            "filled_icon": false,
            "row_content": "<p>[FILL: explain exactly how.] It has electronics inside, so it cannot go in a washing machine or be submerged. Spot clean the fabric and let it dry fully — this is a toy that will get dribbled on daily, so parents need a clear answer.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "collapsible_row_q1",
        "collapsible_row_q2",
        "collapsible_row_q3",
        "collapsible_row_q4",
        "collapsible_row_q5",
        "collapsible_row_q6"
      ],
