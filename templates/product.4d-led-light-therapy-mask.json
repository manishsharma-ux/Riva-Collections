ct-reviews\/blocks\/lai-product-section\/cad3c6c6-329e-4416-ba74-b79359b5b6e1","settings":{"lai_product":"","title":"","use_other_product":false}}},"block_order":["lai_product_reviews_lai_product_section_UFNLCk"],"settings":{"display_id":false,"include_margins":true}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_q1":{"type":"collapsible_row","settings":{"heading":"Is This Mask Suitable For All Skin Types?","icon":"quiz","filled_icon":false,"row_content":"<p>It suits most skin types. If your skin is highly sensitive, do a short patch test on a small area first and start with shorter sessions.<\/p>","page":""}},"collapsible_row_q2":{"type":"collapsible_row","settings":{"heading":"Who Should Avoid Using This Mask?","icon":"quiz","filled_icon":false,"row_content":"<p>Keep your eyes closed throughout every session, and use the eye protection supplied with the mask. Avoid use if you are taking medication that increases light sensitivity (such as isotretinoin or certain antibiotics), if you have epilepsy or a photosensitive condition, or if you have broken or irritated skin. If you are pregnant or under a dermatologist's care, check with them before starting.<\/p>","page":""}},"collapsible_row_q3":{"type":"collapsible_row","settings":{"heading":"How Often Should I Use The Mask?","icon":"quiz","filled_icon":false,"row_content":"<p>Around 3–5 sessions a week of 10–20 minutes each is a typical routine. Follow the timings in the user manual rather than using it for longer.<\/p>","page":""}},"collapsible_row_q4":{"type":"collapsible_row","settings":{"heading":"What Are The 9 Light Modes?","icon":"quiz","filled_icon":false,"row_content":"<p>[FILL: list each mode with its wavelength in nm and what it is intended for. Buyers compare LED masks on wavelengths, so leaving this vague costs conversions as well as accuracy.]<\/p>","page":""}},"collapsible_row_q5":{"type":"collapsible_row","settings":{"heading":"Does It Treat Acne Or Dark Spots?","icon":"quiz","filled_icon":false,"row_content":"<p>This is a cosmetic light-therapy device for at-home skincare routines. It is not a treatment for acne, pigmentation, or any other skin condition, and it does not replace medical advice. If you are dealing with persistent acne or dark spots, a dermatologist is the right place to start.<\/p>","page":""}},"collapsible_row_q6":{"type":"collapsible_row","settings":{"heading":"Can I Use It While Charging?","icon":"quiz","filled_icon":false,"row_content":"<p>It is designed for cordless use once charged. Charge it fully, unplug it, and then wear it — using it plugged in is less comfortable and not recommended.<\/p>","page":""}}},"block_order":["collapsible_row_q1","collapsible_row_q2","collapsible_row_q3","collapsible_row_q4","collapsible_row_q5","collapsible_row_q6"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}",".collapsible-none-layout details.accordion__details {background: #c7a3d1; color: #fff;}",".accordion .material-symbols-outlined {color: #fff;}",".accordion__title {color: #fff;}",".accordion.animate-item.animate-item--child.accordion--medium.accordion--top-border {margin-bottom: 15px;}",".accordion__details {padding: 0 10px;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h2","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#121212","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#121212"}},"b321ab88-2b59-4dba-b