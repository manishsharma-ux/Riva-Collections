":"check_circle","filled_icon":false,"title":"Quick Fold & Storage","text":"<p>Incredibly easy to fold and store away when not in use. Whether you’re traveling or at home, it’s designed for convenience.<\/p>"}},"icon_mX3KDB":{"type":"icon","settings":{"icon":"check_circle","filled_icon":false,"title":"Durable, Comfortable Fabric","text":"<p>Made with high-quality, breathable fabric, this chair is designed to be gentle on your baby’s skin while being durable for everyday use.<\/p>"}},"image_UrG4B7":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Adobe_Express_-_03_gif.gif","atc_product":"","atc_skip_cart":false}}},"block_order":["icon_DwkV7q","icon_N4MYax","icon_6NfAM7","icon_mX3KDB","image_UrG4B7"],"disabled":true,"name":"Icons with content","settings":{"display_id":false,"visibility":"always-display","color_scheme":"background-1","icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h2","icon_text_alignment":"left","icons_desktop_layout":"1-column","icons_mobile_layout":"1-column","desktop_content_alignment":"left","layout":"image_first","mobile_layout":"text_first","hide_content_on_mobile":false,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d"}},"testimonials_qBHNbX":{"type":"testimonials","blocks":{"column_PfJECp":{"type":"column","settings":{"title":"","text":"<p><em>We love how easy it is to carry around. Perfect for family outings and trips to the park!<\/em><\/p>","author_avatar":"shopify:\/\/shop_images\/c37.jpg","author":"<em><strong>Rahul, Mumbai<\/strong><\/em>"}},"column_aGVzRR":{"type":"column","settings":{"title":"","text":"<p><em>I was unsure at first, but this chair is amazing—comfortable for my baby, easy to use, foldable, and travel-friendly!<\/em><\/p>","author_avatar":"shopify:\/\/shop_images\/c20.jpg","author":"<em><strong>Priya S., Mumbai<\/strong><\/em>"}},"column_3aeFDV":{"type":"column","settings":{"title":"","text":"<p><em>I bought this chair for my 8-month-old—compact, comfy, travel-friendly, and easy to clean. My baby loves sitting in it!<\/em><\/p>","author_avatar":"shopify:\/\/shop_images\/c7.jpg","author":"<em><strong>Arjun, Delhi<\/strong><\/em>"}},"column_39Ukef":{"type":"column","settings":{"title":"","text":"<p>My wife and I love how easy this chair is to clean! The tray comes off easily, and it’s so practical for both playtime and meals. <\/p>","author_avatar":"shopify:\/\/shop_images\/c29.jpg","author":"<em><strong>Pramod Gurgaon<\/strong><\/em>"}}},"block_order":["column_PfJECp","column_aGVzRR","column_3aeFDV","column_39Ukef"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"💬 What Parents Are Saying","title_highlight_color":"#6d388b","heading_size":"h2","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"loop","autoplay":true,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":true,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":true,"mobile_dots_position":"under","mobile_arrows_position":"hidden","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"image_with_text_XpjFBQ":{"type":"image-with-text","blocks":{"heading_cXFLbq":{"type":"heading","settings":{"title":"👶 Perfect For Which Age Group?","title_highlight_color":"#6d388b","heading_size":"h2"}},"text_NrbzMc":{"type":"text","settings":{"text":"<p>Ideal for <strong>newborns up to 3 years<\/strong> old – safe, comfortable, and convenient for diaper changes through your baby’s early growing years.<\/p>","text_style":"body"}}},"block_order":["heading_cXFLbq","text_NrbzMc"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/image-_6.jpg","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"reverse","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":20,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_fMpgCN":{"type":"collapsible_row","settings":{"heading":"Is the chair safe for babies?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes, the chair is designed with your baby’s safety as the top priority. It comes with a <strong>3-point safety harness<\/strong> that secures your baby around the waist and between the legs, preventing slipping or accidental falls. The sturdy frame and anti-slip feet add extra stability, so you can feed your little one with complete peace of mind.<br\/><br\/><\/p>","page":""}},"collapsible_row_q9VBEc":{"type":"collapsible_row","settings":{"heading":"What age group is this chair suitable for?","icon":"quiz","filled_icon":false,"row_content":"<p>The chair is ideal for babies from <strong>3 months up to 36 months<\/strong>, and it can hold up to <strong>33 kg of weight<\/strong>. Whether your baby is just starting solids or is a toddler enjoying mealtime with the family, this chair grows with them, making it a long-lasting solution for everyday use.<\/p>","page":""}},"collapsible_row_QMKegb":{"type":"collapsible_row","settings":{"heading":"Is the tray removable?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes! The dining tray is <strong>fully detachable<\/strong>, making it extremely convenient for parents. You can easily remove it for quick cleaning, or take it off when your baby wants to use the chair as a play seat. The tray is made with high-quality, easy-to-clean material so food spills and messes can be wiped away in seconds.<\/p>","page":""}},"collapsible_row_hYtPED":{"type":"collapsible_row","settings":{"heading":"Is this chair easy to carry around?","icon":"quiz","filled_icon":false,"row_content":"<p>Absolutely! The chair is <strong>lightweight, foldable, and compact<\/strong>, which makes it perfect for both home and travel. It can be folded flat in seconds and stored in your car, stroller basket, or even a travel bag. Parents love using it during family outings, picnics, holidays, or restaurant visits, as it saves them from unhygienic public high chairs.<\/p>","page":""}},"collapsible_row_bbh47c":{"type":"collapsible_row","settings":{"heading":"How do I clean the chair?","icon":"quiz","filled_icon":false,"row_content":"<p>Cleaning this chair is very simple. The <strong>fabric seat is easy to wipe down<\/strong> with a damp cloth after mealtime. For deeper cleaning, the cover can be removed and machine washed. The dining tray is also detachable, so you can wash it under running water or simply wipe it clean with a baby-safe disinfectant. This ensures your baby always has a fresh and hygienic seat.<\/p>","page":""}},"collapsible_row_D6WbwP":{"type":"collapsible_row","settings":{"heading":"Do you offer Cash on Delivery (COD)?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes, we offer <strong>Cash on Delivery across India<\/strong>. You can pay for the chair once it’s delivered to your doorstep, giving you extra confidence while shopping online. For hassle-free service, you’ll also receive regular updates and tracking information until your order arrives safely.<\/p>","page":""}}},"block_order":["collapsible_row_fMpgCN","collapsible_row_q9VBEc","collapsible_row_QMKegb","collapsible_row_hYtPED","collapsible_row_bbh47c","collapsible_row_D6WbwP"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#2e2a39"}},"174375794036da818e":{"type":"apps","blocks":{"lai_product_reviews_lai_product_section_yTGtC4":{"type":"shopify:\/\/apps\/lai-product-reviews\/blocks\/lai-product-section\/cad3c6c6-329e-4416-ba74-b79359b5b6e1","settings":{"lai_product":"","title":"","use_other_product":false}}},"block_order":["lai_product_reviews_lai_product_section_yTG