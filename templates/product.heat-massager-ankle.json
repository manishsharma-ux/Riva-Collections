_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d"}},"testimonials_fcqq77":{"type":"testimonials","blocks":{"column_JW3HUY":{"type":"column","settings":{"title":"","text":"<p>Roz office ke baad ankle dard hota tha 😩 — ab heat therapy se instant relief milta hai!<\/p>","author":"Ramesh, Delhi"}},"column_EBtjRr":{"type":"column","settings":{"title":"","text":"<p>Mujhe laga vibration se kuch farak nahi padega… but yeh ankle massager ne sach-me pain vanish kar diya 👣🔥<\/p>","author":"Neha, Mumbai"}},"column_R4QQtr":{"type":"column","settings":{"title":"","text":"<p>Salon me 10+ hours khade rehna padta hai — ab na pain hota hai, na swelling. Best device!<\/p>","author":"Komal, Pune"}},"column_9nEUxk":{"type":"column","settings":{"title":"","text":"<p>Office ke liye perfect. Soft, warm, washable — aur slip bhi nahi hota. Super comfortable!<\/p>","author":"Amit, Bengaluru"}},"column_JJwEyU":{"type":"column","settings":{"title":"","text":"<p>Sports aur evening walks ke baad ankle tight ho jata tha — ab heat + vibration se cloud-like relief ☁️💙<\/p>","author":"Varun, Hyderabad"}}},"block_order":["column_JW3HUY","column_EBtjRr","column_R4QQtr","column_9nEUxk","column_JJwEyU"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"💬 Real Stories, Real Relief","title_highlight_color":"#6d388b","heading_size":"h2","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"loop","autoplay":true,"autoplay_speed":3,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"hidden","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_fMpgCN":{"type":"collapsible_row","settings":{"heading":"Will it fit my ankle size?","icon":"quiz","filled_icon":false,"row_content":"<p><strong>✅ <\/strong>Yes! The wrap is made with soft, stretchable fabric that adjusts to almost any ankle size — whether you have a slim or broad ankle.<\/p><p>It’s designed for men, women, teens, and seniors, and the adjustable strap ensures a snug, secure fit without feeling tight or uncomfortable.<\/p>","page":""}},"collapsible_row_q9VBEc":{"type":"collapsible_row","settings":{"heading":"Can I wear it while walking or doing daily work?","icon":"quiz","filled_icon":false,"row_content":"<p><strong>✅ <\/strong>Definitely. The device is lightweight and shaped to stay in place even when you move, so you can wear it while walking around the house, doing chores, cooking, office work, or casual outdoor walks.<\/p><p>It won’t slip or bunch up, and the heating\/vibration controls allow you to use it comfortably during light movement.<\/p>","page":""}},"collapsible_row_QMKegb":{"type":"collapsible_row","settings":{"heading":"Does the heat really help with ankle pain or stiffness?","icon":"quiz","filled_icon":false,"row_content":"<p><strong>✅ <\/strong>Yes — the graphene heating element provides deep, even warmth that helps loosen stiff muscles, improve blood flow, and reduce swelling.<\/p><p>Most users feel relief within 5–10 minutes, especially if they have pain from walking, standing long hours, sprains, or cold weather stiffness.<\/p>","page":""}},"collapsible_row_pn3eCN":{"type":"collapsible_row","settings":{"heading":"Is the vibration massage safe for daily use?","icon":"quiz","filled_icon":false,"row_content":"<p><strong>✅ <\/strong>Yes, it’s completely safe. The vibration is designed to be gentle yet effective, helping your ankle muscles relax and reducing tension after long days of standing or walking.<\/p><p>Daily use can help ease swelling, improve flexibility, and make movement feel smoother.<\/p>","page":""}},"collapsible_row_cGG4qH":{"type":"collapsible_row","settings":{"heading":"How long does the battery last?","icon":"quiz","filled_icon":false,"row_content":"<p><strong>✅ <\/strong>The built-in 1800mAh rechargeable battery lasts for multiple 15-minute sessions on a single charge.<\/p><p>Most users get 1–2 days of casual use before needing to recharge, depending on heat level and vibration mode.<\/p>","page":""}}},"block_order":["collapsible_row_fMpgCN","collapsible_row_q9VBEc","collapsible_row_QMKegb","collapsible_row_pn3eCN","collapsible_row_cGG4qH"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}",".collapsible-none-layout details.accordion__details {background: #c7a3d1; color: #fff;}",".accordion .material-symbols-outlined {color: #fff;}",".accordion__title {color: #fff;}",".accordion.animate-item.animate-item--child.accordion--medium.accordion--top-border {margin-bottom: 15px;}",".accordion__details {padding: 0 10px;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h2","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"mediu