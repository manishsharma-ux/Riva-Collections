on-table__row-name {width: 60%;}"],"name":"Comparison table","settings":{"display_id":false,"visibility":"always-display","title":"Don't Waste Money on Duplicates","title_highlight_color":"#6d388b","heading_size":"h2","text":"<p>See how a sprayer glove compares with a mug and a separate brush<\/p>","button_label":"","link":"","button_style_secondary":false,"atc_button_label":"","atc_product":"","atc_skip_cart":false,"desktop_alignment":"left","mobile_alignment":"center","color_scheme":"background-1","layout":"table_second","style":"centered","corner_radius":20,"number_of_competitors":1,"us_label":"Riva collections","us_label_size":18,"logo_width":90,"mobile_logo_width":60,"others_label":"Mug And Brush","others_label_size":18,"others_logo_width":90,"others_mobile_logo_width":60,"others_2_label":"Competitor 2","others_2_label_size":18,"others_2_logo_width":90,"others_2_mobile_logo_width":60,"others_3_label":"Competitor 3","others_3_label_size":18,"others_3_logo_width":90,"others_3_mobile_logo_width":60,"checkmark_style":"regular","checkmark_color":"#ffffff","checkmark_bg_color":"#53af01","x_style":"regular","x_color":"#ff0000","x_bg_color":"#dbdbdb","opposite_icon_colors":"original","highlighted_color_scheme":"accent-1","highlighted_separator_opacity":0,"highlighted_overlay_opacity":0,"other_cells_color_scheme":"background-1","regular_separator_opacity":10,"regular_overlay_opacity":0,"minimalistic_border_opacity":16,"padding_top":24,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_colors_highlighted_background":"#2e2a39","custom_colors_highlighted_text":"#ffffff","custom_colors_others_background":"#ffffff","custom_colors_others_text":"#2e2a39"}},"174375794036da818e":{"type":"apps","blocks":{"lai_product_reviews_lai_product_section_UFNLCk":{"type":"shopify:\/\/apps\/lai-product-reviews\/blocks\/lai-product-section\/cad3c6c6-329e-4416-ba74-b79359b5b6e1","settings":{"lai_product":"","title":"","use_other_product":false}}},"block_order":["lai_product_reviews_lai_product_section_UFNLCk"],"settings":{"display_id":false,"include_margins":true}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_q1":{"type":"collapsible_row","settings":{"heading":"Will It Fit My Tap Or Shower?","icon":"quiz","filled_icon":false,"row_content":"<p>[FILL: this is the question that decides whether the product works at all. List every adapter included and the fittings it suits, and test it against a normal Indian bathroom tap and shower hose before ordering stock. Chinese fittings frequently do not match Indian ones, and a sprayer that cannot be connected is a guaranteed return.]<\/p>","page":""}},"collapsible_row_q2":{"type":"collapsible_row","settings":{"heading":"How Warm Should The Water Be?","icon":"quiz","filled_icon":false,"row_content":"<p>Lukewarm, and test it on the inside of your wrist first. Dogs tolerate much less heat than people do and cannot tell you when it is too hot. Keep the pressure gentle too — a hard spray on the face frightens most animals and is the main reason bath time becomes a fight.<\/p>","page":""}},"collapsible_row_q3":{"type":"collapsible_row","settings":{"heading":"Can I Use It On My Pet's Face?","icon":"quiz","filled_icon":false,"row_content":"<p>Keep the spray off the face, and particularly out of the eyes and ears. Water in the ear canal is a common cause of ear infections in dogs, especially floppy-eared breeds. Wash the head last with a damp cloth instead, and dry the ears properly afterwards.<\/p>","page":""}},"collapsible_row_q4":{"type":"collapsible_row","settings":{"heading":"Does It Work For Cats?","icon":"quiz","filled_icon":false,"row_content":"<p>Honestly, most cats do not want to be bathed at all and a spray tool will not change that. It works well on dogs. If you do need to wash a cat — for a spill or on a vet's advice — go slowly, keep the water off the head entirely, and stop if they are distressed rather than pushing through.<\/p>","page":""}},"collapsible_row_q5":{"type":"collapsible_row","settings":{"heading":"Is It Gentle Enough For Regular Use?","icon":"quiz","filled_icon":false,"row_content":"<p>The nubs are soft silicone, so they are kinder than stiff bristles. Do not use it over cuts, hot spots, rashes or any irritated skin, and if your pet's skin looks sore or they are scratching a lot, that is a vet question rather than a grooming one.<\/p>","page":""}},"collapsible_row_q6":{"type":"collapsible_row","settings":{"heading":"How Do I Clean It?","icon":"quiz","filled_icon":false,"row_content":"<p>[FILL: explain how to clear hair and shampoo out of the nubs and the spray nozzle.] Rinse it through with clean water after every bath — soap residue drying inside the nozzle is what blocks the spray holes, and people assume the product has failed.<\/p>","page":""}}},"block_order":["collapsible_row_q1","collapsible_row_q2","collapsible_row_q3","collapsible_row_q4","collapsible_row_q5","collapsible_row_q6"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}",".collapsible-none-layout details.accordion__details {background: #c7a3d1; color: #fff;}",".accordion .material-symbols-outlined {color: #fff;}",".accordion__title {color: #fff;}",".accordion.animate-item.animate-item--child.accordion--medium.accordion--top-border {margin-bottom: 15px;}",".accordion__details {padding: 0 10px;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h2","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium