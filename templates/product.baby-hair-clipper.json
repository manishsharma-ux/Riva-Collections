video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"normal","mobile_image_quanlity":"2","mobile_content_alignment":"left","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":20,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_fMpgCN":{"type":"collapsible_row","settings":{"heading":" Is it safe for kids?","icon":"quiz","filled_icon":false,"row_content":"<p>Absolutely! This hair clipper is designed specifically for babies and toddlers. It features ultra-soft, rounded stainless steel blades that gently trim hair without scratching or pulling. The built-in vacuum ensures that cut hair is sucked away immediately, keeping your child comfortable and preventing irritation. It’s free from harmful chemicals, lightweight, and ergonomically designed for safe handling.<br\/><br\/><\/p>","page":""}},"collapsible_row_q9VBEc":{"type":"collapsible_row","settings":{"heading":"Does it hurt or scare the child?","icon":"quiz","filled_icon":false,"row_content":"<p>Not at all! The clipper operates quietly with minimal vibration to avoid startling your child. The gentle cutting action combined with the vacuum keeps hair from falling on the skin, making haircutting calm, comfortable, and fuss-free.<\/p>","page":""}},"collapsible_row_QMKegb":{"type":"collapsible_row","settings":{"heading":"How is it powered?","icon":"quiz","filled_icon":false,"row_content":"<p>The clipper is rechargeable via USB, providing cord-free convenience. A single full charge allows multiple uses, and the LED indicator clearly shows when it’s time to recharge.<\/p>","page":""}},"collapsible_row_hYtPED":{"type":"collapsible_row","settings":{"heading":"Is it easy to carry around?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes! The compact and lightweight design makes it perfect for home use or travel. You can easily take it in a diaper bag or luggage, ensuring grooming is convenient wherever you go.<\/p>","page":""}},"collapsible_row_G9bRGb":{"type":"collapsible_row","settings":{"heading":"Is it durable for daily use?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes. Made with high-quality ABS plastic and stainless steel blades, the clipper is built to last. The vacuum system is designed for consistent performance, so you can rely on it for regular haircuts without wear or tear.<\/p>","page":""}},"collapsible_row_bbh47c":{"type":"collapsible_row","settings":{"heading":"Do you offer Cash on Delivery?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes! We provide Cash on Delivery across India, along with secure prepaid payment options. Parents can shop with confidence, knowing they have a safe, convenient, and reliable way to purchase this essential baby grooming tool.<\/p>","page":""}}},"block_order":["collapsible_row_fMpgCN","collapsible_row_q9VBEc","collapsible_row_QMKegb","collapsible_row_hYtPED","collapsible_row_G9bRGb","collapsible_row_bbh47c"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":tr