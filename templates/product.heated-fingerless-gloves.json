sktop_spacing":28,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","mobile_full_page":false,"mobile_border_radius":0,"slides_mobile":2,"per_move_mobile":1,"mobile_spacing":12,"mobile_side_padding":0,"mobile_padding_calc":true,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"sides","padding_top":0,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#121212"}},"testimonials_qBHNbX":{"type":"testimonials","blocks":{"column_PfJECp":{"type":"column","settings":{"title":"","text":"<p>These gloves are amazing! I work on my laptop all day, and my hands stay warm without feeling sweaty. Total game changer for winter!<\/p>","author":"<em><strong>Anita S. – Office Worker<\/strong><\/em>"}},"column_39Ukef":{"type":"column","settings":{"title":"","text":"<p><em>I play games for hours, and these gloves keep my hands flexible and warm. No more freezing while playing at night!<\/em><\/p>","author":"<em><strong>Rahul T. – Gamer<\/strong><\/em>"}},"column_Frx3qn":{"type":"column","settings":{"title":"","text":"<p><em>I use them while studying during cold nights. Very soft, comfortable, and heats up fast. Worth every rupee!<\/em><\/p>","author":"<em><strong>Neha P. – Student<\/strong><\/em>"}}},"block_order":["column_PfJECp","column_39Ukef","column_Frx3qn"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"💖 Why Loved By Our Customers","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"loop","autoplay":true,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":true,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":true,"mobile_dots_position":"under","mobile_arrows_position":"hidden","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_fMpgCN":{"type":"collapsible_row","settings":{"heading":"How do these gloves heat up?","icon":"quiz","filled_icon":false,"row_content":"<p>These gloves come with built-in heating pads that warm up as soon as you connect them to a USB power source. You can plug them into your laptop, computer, power bank, or USB adapter. Within seconds, the gloves begin to emit gentle, consistent heat to keep your hands cozy. No setup or extra batteries are required — just plug and feel the warmth!<\/p>","page":""}},"collapsible_row_q9VBEc":{"type":"collapsible_row","settings":{"heading":"Are the gloves safe to use for long hours?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes, absolutely! The gloves are powered by a low-voltage 5V USB connection — the same safe voltage used in most electronic devices. The heating elements are designed to maintain a stable, comfortable temperature that never gets too hot. You can safely wear them for long periods while working, gaming, or studying without worrying about overheating or burns.<\/p>","page":""}},"collapsible_row_QMKegb":{"type":"collapsible_row","settings":{"heading":"Can I still type or use my phone while wearing them?","icon":"quiz","filled_icon":false,"row_content":"<p>Definitely! These are <strong>fingerless gloves<\/strong>, so your fingertips remain free to type, text, write, or scroll on your phone easily. The design gives you full flexibility while still keeping your palms and hands warm. It’s perfect for anyone who needs to stay active with their hands — from office workers to gamers and students.<\/p>","page":""}},"collapsible_row_hYtPED":{"type":"collapsible_row","settings":{"heading":"Do I need batteries or charging?","icon":"quiz","filled_icon":false,"row_content":"<p>No, you don’t need any batteries or charging time! The gloves work directly through a USB connection, making them convenient and hassle-free. Just plug them in and enjoy continuous warmth as long as they’re connected. You can even use a portable power bank to stay warm on the go.<br\/><br\/><\/p>","page":""}},"collapsible_row_TtRmfM":{"type":"collapsible_row","settings":{"heading":"How long does it take for the gloves to heat up?","icon":"quiz","filled_icon":false,"row_content":"<p>The heating pads begin warming up almost instantly — usually within <strong>10 to 20 seconds<\/strong> of plugging in. You’ll feel noticeable warmth spreading through your palms quickly, and within a minute, the temperature stabilizes at a comfortable, soothing level.<\/p>","page":""}}},"block_order":["collapsible_row_fMpgCN","collapsible_row_q9VBEc","collapsible_row_QMKegb","collapsible_row_hYtPED","collapsible_row_TtRmfM"],"custom_css":[".collapsible-content-wrapper-narrow {max-width: 100.4rem;}"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":