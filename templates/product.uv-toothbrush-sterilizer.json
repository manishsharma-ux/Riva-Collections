s_position":"under","mobile_arrows_position":"sides","padding_top":0,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#121212"}},"testimonials_qBHNbX":{"type":"testimonials","blocks":{"column_jUV3BK":{"type":"column","settings":{"title":"","text":"<p><em>I was shocked at how easy it is to use. Just one button and it sterilizes automatically. No more worrying about germs or foul smell on our toothbrushes.<\/em><\/p>","author":"<em><strong>Ritesh Bansal, Mumbai<\/strong><\/em>"}},"column_3TqMYp":{"type":"column","settings":{"title":"","text":"<p>Compact, smart, and super effective! The UV light works silently but makes a big difference. Now I can’t imagine using an unsterilized toothbrush again.<\/p>","author":"<em><strong>Sneha Verma, Hyderabad<\/strong><\/em>"}},"column_xhzVaX":{"type":"column","settings":{"title":"","text":"<p><em>Love the design and functionality! It’s perfect for families — even my kids have their brushes safely sterilized every night. Worth every rupee.<\/em><\/p>","author":"<em><strong>Pranav Shah, Pune<\/strong><\/em>"}},"column_DzaJJK":{"type":"column","settings":{"title":"","text":"<p><em>This smart UV sterilizer looks so sleek in my bathroom. It saves space, keeps everything organized, and ensures every brush stays fresh and hygienic.<\/em><\/p>","author":"<em><strong>Aishwarya Menon, Bangalore<\/strong><\/em>"}},"column_9BAPGg":{"type":"column","settings":{"title":"","text":"<p><em>Finally — a toothbrush holder that actually keeps brushes clean! The UV sterilization is quick, reliable, and gives me total peace of mind every morning.<\/em><\/p>","author":"<em><strong>Neha Kapoor, Delhi<\/strong><\/em>"}}},"block_order":["column_jUV3BK","column_3TqMYp","column_xhzVaX","column_DzaJJK","column_9BAPGg"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"💬 What Customers Are Saying","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-1","image_width":"full","image_ratio":"square","column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":true,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"loop","autoplay":true,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":true,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":true,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":true,"mobile_dots_position":"under","mobile_arrows_position":"hidden","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"image_with_text_Bxdr4h":{"type":"image-with-text","blocks":{"heading_UfGd7A":{"type":"heading","settings":{"title":"<strong>🪥 <\/strong>How to Use (Super Simple)","title_highlight_color":"#6d388b","heading_size":"h2"}},"text_KRjdbh":{"type":"text","settings":{"text":"<ol><li>Stick the wall mount on a clean surface.<br\/><\/li><li>Place your toothbrush inside the UV slot.<br\/><\/li><li>Press the button once — sterilization starts.<br\/><\/li><li>UV light turns off automatically when done.<\/li><\/ol>","text_style":"body"}}},"block_order":["heading_UfGd7A","text_KRjdbh"],"name":"t:sections.image-with-text.presets.name","settings":{"display_id":false,"visibility":"always-display","image":"shopify:\/\/shop_images\/UV_Brush_Sterilizer_GIF_1_1_1.gif","video_autoplay":true,"video_loop":true,"height":"adapt","color_scheme":"background-1","section_color_scheme":"background-1","full_desktop_width":false,"content_layout":"no-overlap","desktop_media_width":50,"layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","mobile_full_media_width":false,"mobile_direction":"reverse","mobile_image_quanlity":"2","mobile_content_alignment":"center","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":36,"desktop_padding_bottom":36,"custom_colors_background":"#2e2a39","custom_gradient_background":"","custom_colors_text":"#ffffff","custom_colors_solid_button_background":"#dd1d1d","custom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d","custom_section_colors_background":"#ffffff","custom_section_gradient_background":""}},"collapsible_content_EUY8hK":{"type":"collapsible-content","blocks":{"collapsible_row_CBpPJQ":{"type":"collapsible_row","settings":{"heading":"Is this UV toothbrush sterilizer safe to use daily?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes, absolutely. The UV-C light used in this sterilizer is completely safe for daily use. It’s enclosed within the device and automatically shuts off when opened, ensuring there’s no direct exposure. You can safely sterilize your toothbrushes multiple times a day for maximum hygiene.<\/p>","page":""}},"collapsible_row_ACbDLQ":{"type":"collapsible_row","settings":{"heading":"How does the UV-C sterilization actually work?","icon":"quiz","filled_icon":false,"row_content":"<p>The built-in UV-C light destroys the DNA and RNA of bacteria and viruses on your toothbrush bristles — killing 99.9% of germs in just a few minutes. It effectively eliminates harmful microbes that water or air drying can’t remove.<\/p>","page":""}},"collapsible_row_rrNJ9P":{"type":"collapsible_row","settings":{"heading":"Can it fit all types of toothbrushes?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes. The holder is designed to fit most standard and electric toothbrush heads. It can easily accommodate family sets, making it ideal for both adults and kids.<\/p>","page":""}},"collapsible_row_BRgTqC":{"type":"collapsible_row","settings":{"heading":"Is it wall-mounted or can it be placed on a counter?","icon":"quiz","filled_icon":false,"row_content":"<p> It’s primarily designed for wall mounting — saving bathroom space and keeping brushes off the sink area. However, it can also be placed flat on a counter if preferred. The adhesive wall mount is included for easy installation.<\/p>","page":""}},"collapsible_row_aiLYkH":{"type":"collapsible_row","settings":{"heading":"How long does the sterilization process take?","icon":"quiz","filled_icon":false,"row_content":"<p>The automatic sterilization cycle runs for 360 seconds (6 minutes) per session. After the timer ends, the device automatically shuts off — ensuring perfect sterilization without wasting energy.<\/p>","page":""}},"collapsible_row_P6bJHE":{"type":"collapsible_row","settings":{"heading":"What kind of power source does it use?","icon":"quiz","filled_icon":false,"row_content":"<p>It runs on a USB power connection — energy-efficient and easy to connect with standard adapters or bathroom power outlets. Once plugged in, it consumes minimal electricity while providing powerful sterilization performance.<\/p>","page":""}},"collapsible_row_tURDkq":{"type":"collapsible_row","settings":{"heading":" Does it remove bad odor or prevent mold?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes. Regular UV-C sterilization helps prevent the buildup of odor-causing bacteria and moisture, keeping toothbrushes dry, fresh, and free from mold or mildew.<\/p>","page":""}},"collapsible_row_mNR4Mf":{"type":"collapsible_row","settings":{"heading":" Is it suitable for families?","icon":"quiz","filled_icon":false,"row_content":"<p>Definitely. It’s designed to hold multiple toothbrushes at once, making it ideal for family use. Everyone’s brush stays individually sterilized, hygienic, and ready to use.<\/p>","page":""}},"collapsible_row_VikQkq":{"type":"collapsible_row","settings":{"heading":"How do I clean the sterilizer itself?","icon":"quiz","filled_icon":false,"row_content":"<p>Simply wipe the exterior with a soft, dry or slightly damp cloth. Avoid direct water contact with the inner UV components to maintain its efficiency and longevity.<\/p>","page":""}},"collapsible_row_EP49Cb":{"type":"collapsible_row","settings":{"heading":"Do you offer Cash on Delivery (COD)?","icon":"quiz","filled_icon":false,"row_content":"<p>Yes. Cash on Delivery is available across India, ensuring a safe and convenient shopping experience for all customers.<\/p>","page":""}}},"block_order":["collapsible_row_CBpPJQ","collapsible_row_ACbDLQ","collapsible_row_rrNJ9P","collapsible_row_BRgTqC","collapsible_row_aiLYkH","collapsible_row_P6bJHE","collapsible_row_tURDkq","collapsible_row_mNR4Mf","collapsible_row_VikQkq","collapsible_row_EP49Cb"],"settings":{"display_id":false,"visibility":"always-display","caption":"","title":"Frequently Asked Questions (FAQs)","title_highlight_color":"#6d388b","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#2e2a39"}},"174375794036da818e":{"type":"apps","blocks":{"lai_product_reviews_lai_product_section_L34LVA":{"type":"shopify:\/\/apps\/lai-product-reviews\/blocks\/lai-product-section\/cad3c6c6-329e-4416-ba74-b79359b5b6e1","settings":{"lai_product":"","title":"","use_other_product":false}}},"block_order":["lai_product_reviews_lai_product_section_L34LVA"],"settings":{"display_id":false,"include_margins":true}},"1749814974f7cc4cd6":{"type":"apps","settings":{"display_id":false