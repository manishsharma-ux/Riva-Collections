{%- if section.blocks.size > 0 -%}
  {%- assign view_all_link = section.settings.link | default: routes.all_products_collection_url -%}
  <section class="riva-edits page-width" aria-labelledby="RivaEdits-{{ section.id }}">
    <div class="riva-edits__header">
      <h2 id="RivaEdits-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="riva-text-link" href="{{ view_all_link }}">{{ section.settings.link_label | escape }}&nbsp;<span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
    <ul class="riva-edits__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign edit_product = block.settings.product
          assign edit_image = block.settings.image | default: edit_product.featured_image
          assign edit_url = block.settings.link | default: edit_product.url | default: routes.all_products_collection_url
          assign edit_label = block.settings.label | default: edit_product.title | default: section.settings.heading
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="riva-edit" href="{{ edit_url }}">
            {%- if edit_image != blank -%}
              <div class="riva-edit__media">
                {{ edit_image | image_url: width: 900 | image_tag: widths: '240, 360, 540, 720, 900', sizes: '(min-width: 1400px) 320px, (min-width: 990px) 24vw, 48vw', loading: 'lazy', alt: '' }}
              </div>
            {%- endif -%}
            <span class="riva-edit__label">
              <span>{{ edit_label | escape }}</span>
              <span class="riva-edit__arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false"><path d="M4 10 10 4M5 4h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Riva featured finds",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our featured finds" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to all products." }
  ],
  "blocks": [
    {
      "type": "edit",
      "name": "Featured find",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "Riva featured finds" }]
}
{% endschema %}
